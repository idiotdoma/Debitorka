# Environment Variables Example
# Copy this file to .env and fill in the values

# Application
VITE_APP_NAME=Дебиторка
VITE_APP_ENV=development

# Database (for future backend implementation)
# DATABASE_URL=postgresql://user:password@localhost:5432/debitor

# Authentication (for future backend implementation)
# JWT_SECRET=your-secret-key-here
# SESSION_SECRET=your-session-secret-here

# 1C Integration (optional)
# ONEC_API_URL=https://your-1c-server.com/odata
# ONEC_API_KEY=your-api-key

# Email Service (for future notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# AI Assistant (optional)
# OPENAI_API_KEY=your-openai-api-key
# AI_MODEL=gpt-4

# File Storage (for future attachments)
# STORAGE_BUCKET=debitor-files
# STORAGE_ENDPOINT=https://storage.example.com

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn
